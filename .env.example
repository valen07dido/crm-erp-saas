# Example environment variables for CRM+ERP SaaS

# PostgreSQL connection string (adjust user, password, host, port, db name)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_erp_saas?schema=public"

# NextAuth secret (generate a long random string)
NEXTAUTH_SECRET="YOUR_RANDOM_SECRET"

# JWT secret (optional, can be same as NEXTAUTH_SECRET)
NEXTAUTH_JWT_SECRET="YOUR_RANDOM_JWT_SECRET"

# S3 / MinIO configuration (optional, for file storage)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="crm-erp-uploads"
