{
  "name": "walti-print-agent",
  "version": "1.0.0",
  "description": "Agente local de impresión silenciosa para tickets POS (ESC/POS vía PDF a la impresora térmica).",
  "private": true,
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js",
    "build": "pkg . --targets node18-win-x64 --output dist/print-agent.exe"
  },
  "dependencies": {
    "pdf-to-printer": "^5.6.0",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
