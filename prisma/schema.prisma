// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Common fields for all tables
model Base {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // soft delete
}

/// User accounts (global)
model User {
  @@map("users")
  // Base fields
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Auth fields
  email        String   @unique
  username     String?  @unique
  passwordHash String
  name         String?

  // Relations
  businessUsers BusinessUser[]
  userRoles     UserRole[]
  // Audit logs, etc. can be added later
}

/// Business (tenant) entity
model Business {
  @@map("businesses")
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  name        String
  slug        String   @unique
  logoUrl     String?
  isActive    Boolean  @default(true)
  planName    String   @default("BASIC") // BASIC, PRO, ENTERPRISE
  planExpiresAt DateTime?
  // additional settings fields can be added later

  ownerId     String?
  businessSettings BusinessSettings?

  // Back‑relations for multi‑tenant entities
  businessUsers BusinessUser[]
  roles        Role[]
  userRoles    UserRole[]
  products     Product[]
  storefront   Storefront?
  clients      Client[]
  suppliers    Supplier[]
  sales        Sale[]
  purchases    Purchase[]
  transactions Transaction[]
  combos       Combo[]
}

model Storefront {
  @@map("storefronts")
  id            String   @id @default(uuid())
  businessId    String   @unique
  business      Business @relation(fields: [businessId], references: [id])
  
  heroTitle     String?  @default("Bienvenido a nuestra tienda")
  heroSubtitle  String?  @default("Los mejores productos al mejor precio")
  heroImageUrl  String?
  primaryColor  String?  @default("#3b82f6") // tailwind blue-500
  secondaryColor String? @default("#3D9488") // Walti petroleum green, as a starting point — fully overridable per store
  backgroundColor String? @default("#09090b")
  themeMode     String   @default("dark")

  // "walti" | "clasica" | "directa" — a short, curated list of font pairings
  // (see StorefrontView), not a free-text font picker.
  fontPairing   String?  @default("walti")
  // "rounded" | "pill" | "square"
  buttonStyle   String?  @default("rounded")
  // Reserved for the Editorial/Comercial/Bold template system — only
  // "editorial" is implemented so far, but the column exists now so adding
  // the other templates later doesn't need another migration.
  template      String?  @default("editorial")
  faviconUrl    String?

  logoUrl       String?
  aboutText     String?
  aboutImageUrl String?

  // Shown in the storefront footer/contact area — all optional.
  contactPhone  String?
  contactEmail  String?
  contactAddress String?
  whatsappNumber String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BusinessSettings {
  @@map("business_settings")
  id          String   @id @default(uuid())
  businessId  String   @unique
  business    Business @relation(fields: [businessId], references: [id])
  currency    String   @default("USD")
  taxRate     Float    @default(0)

  // Editable hour ranges (0-23) for each shift, used by the "Ventas por Turno" report.
  // The ranges need not be contiguous or cover the full day (e.g. 8-12 and 16-21).
  shiftMorningStartHour Int    @default(8)
  shiftMorningEndHour   Int    @default(12)
  shiftNightStartHour   Int    @default(16)
  shiftNightEndHour     Int    @default(21)
  shiftMorningLabel     String @default("Turno Mañana")
  shiftNightLabel       String @default("Turno Noche")

  // Receipt/ticket printing (thermal printer paper width in mm — 58 or 80 are common)
  ticketWidthMm     Int     @default(58)
  printTicketOnSale Boolean @default(false)
  // Some thermal printer drivers always print shifted right by a fixed
  // physical amount regardless of what margins the PDF requests — a
  // per-printer hardware/driver quirk, measured once on a real test ticket
  // and compensated for as extra right margin (see
  // walti-desktop/src/main/print/ticket-pdf.ts). Editable from Configuración
  // so recalibrating a printer doesn't require rebuilding the installer.
  printLeftOffsetMm Float   @default(0)
}

model BusinessUser {
  @@map("business_users")
  id          String   @id @default(uuid())
  userId      String
  businessId  String
  roleId      String
  // "ADMIN" (full access) or "POS" (Punto de Venta only)
  role        String   @default("ADMIN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  business    Business @relation(fields: [businessId], references: [id])
  roleRef     Role     @relation(fields: [roleId], references: [id])
}

model Role {
  @@map("roles")
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  businessId  String?

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  business        Business? @relation(fields: [businessId], references: [id])
  businessUsers   BusinessUser[]
}

model Permission {
  @@map("permissions")
  id   String @id @default(uuid())
  name String @unique
  description String?
  rolePermissions RolePermission[]
}

model RolePermission {
  @@map("role_permissions")
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role        Role        @relation(fields: [roleId], references: [id])
  permission  Permission  @relation(fields: [permissionId], references: [id])
}

model UserRole {
  @@map("user_roles")
  id        String @id @default(uuid())
  userId    String
  roleId    String
  businessId String

  user      User @relation(fields: [userId], references: [id])
  role      Role @relation(fields: [roleId], references: [id])
  business  Business @relation(fields: [businessId], references: [id])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @default(0)
  stock       Decimal  @default(0)
  imageUrl    String?
  barcode     String?  // EAN13, Code128, etc.
  category    String?
  expirationDate DateTime?
  soldByWeight   Boolean @default(false) // if true, price is per-kg and quantities are in kg
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  comboItems    ComboItem[]
}

/// A fixed-price bundle of existing products (e.g. "Combo x3 $5000") sold as
/// a single line item; selling one decrements stock from its component products.
model Combo {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @default(0)
  imageUrl    String?
  barcode     String?
  isActive    Boolean  @default(true)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       ComboItem[]
  saleItems   SaleItem[]
}

model ComboItem {
  id        String  @id @default(uuid())
  comboId   String
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal
}

model Client {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  address     String?
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales       Sale[]
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  address     String?
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   Purchase[]
}

model Sale {
  id          String   @id @default(uuid())
  total       Decimal  @default(0)
  status      String   @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       SaleItem[]
}

model SaleItem {
  id          String   @id @default(uuid())
  quantity    Decimal
  price       Decimal
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Exactly one of productId/comboId is set — a combo is sold as a single
  // line item (its component products are the ones that lose stock).
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  comboId     String?
  combo       Combo?   @relation(fields: [comboId], references: [id])
}

model Purchase {
  id          String   @id @default(uuid())
  total       Decimal  @default(0)
  status      String   @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PurchaseItem[]
}

model PurchaseItem {
  id          String   @id @default(uuid())
  quantity    Decimal
  price       Decimal
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
}

model Transaction {
  id          String   @id @default(uuid())
  type        String   // INCOME, EXPENSE
  amount      Decimal
  description String
  category    String?
  date        DateTime @default(now())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// WALTI Marketing Studio — internal tool (superadmin only), not tenant data.
// These tables are WALTI's own marketing production, so they have no
// businessId and are never exposed to tenant routes.
// ─────────────────────────────────────────────────────────────────────────────

/// Single-row brand kit (colors, fonts, contact, default CTA).
model MarketingBrandKit {
  @@map("marketing_brand_kit")
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

model MarketingCampaign {
  @@map("marketing_campaigns")
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  status      String   @default("ACTIVE") // DRAFT, ACTIVE, FINISHED
  /// Brief: objective, audience, mainMessage, offer, channels, duration, pieces
  brief       Json
  /// Generated creative pack: concept, angles, headlines, copies, stories, carousels, reels, ctas
  content     Json?

  designs     MarketingDesign[]
}

model MarketingDesign {
  @@map("marketing_designs")
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  format      String   // story, post, portrait, reel-cover
  status      String   @default("DRAFT") // DRAFT, REVIEW, APPROVED
  /// Full editable document: background + layers (see src/lib/marketing/types.ts)
  doc         Json
  /// Small JPEG data URL used by galleries
  thumbnail   String?
  campaignId  String?
  campaign    MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId])
}

model MarketingAsset {
  @@map("marketing_assets")
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  name        String
  category    String   // logo, screenshot, photo, video, icon, other
  url         String
  mimeType    String?
  width       Int?
  height      Int?
  tags        String[]
}
